{
  "name": "meetpoints",
  "version": "1.0.0",
  "description": "Checklist local de entrevistas a candidatos, con SQLite embebido. 100% offline.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Manuel",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.meetpoints.app",
    "productName": "MeetPoints",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm",
      "node_modules/@fontsource-variable/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    }
  }
}
